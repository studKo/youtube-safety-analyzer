# config/settings.py가 읽는 환경변수 목록입니다. 실제 값은 커밋하지 마세요.
# PowerShell 예: $env:DJANGO_DEBUG = "True"; python manage.py runserver

# 비워두면 실행할 때마다 임시 키가 생성됩니다 (로컬 개발용).
# 키 생성: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 로컬 개발 시 True (static 파일 제공), 배포 시 False
DJANGO_DEBUG=False

# 쉼표로 구분
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
